# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://teslamall.com"
NEXT_PUBLIC_APP_NAME="Tesla Mall"
NODE_ENV="development"

# ── Database (Supabase Postgres via Prisma) ─────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="tesla-mall-media"

# ── Auth.js ───────────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="https://teslamall.com/api/auth"
AUTH_TRUST_HOST="true"

# OAuth providers (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Payments ──────────────────────────────────────────────────────────────
# Local Yemen gateways
KURAIMI_MERCHANT_ID=""
KURAIMI_API_KEY=""
KURAIMI_API_SECRET=""
KURAIMI_BASE_URL=""

JAWALI_MERCHANT_ID=""
JAWALI_API_KEY=""

JIB_MERCHANT_ID=""
JIB_API_KEY=""

# International fallback
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── SMS / OTP ─────────────────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID="TeslaMall"

# ── Email ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Tesla Mall <no-reply@teslamall.com>"

# ── Monitoring ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
